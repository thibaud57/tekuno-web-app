rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Accès direct à Firestore réservé à l'admin
    match /persons/{document} {
      allow read, write: if request.auth != null 
        && request.auth.token.roles.hasAny(['ADMIN']);
    }

    // Tous les autres accès passent par l'api (Cloud Functions)
    // La gestion des droits est faite à ce niveau
    match /{document=**} {
      allow read, write: if false;
    }
  }
}